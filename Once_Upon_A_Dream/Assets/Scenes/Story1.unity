  m_Script: {fileID: 11500000, guid: 27baf4e93b9648243ae5cbaded8941e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyImages:
  - {fileID: -8603383069536422431, guid: aaf4f03d6c421e240b5a110e8ff92744, type: 3}
  - {fileID: -8603383069536422431, guid: aaf4f03d6c421e240b5a110e8ff92744, type: 3}
  - {fileID: -8603383069536422431, guid: aaf4f03d6c421e240b5a110e8ff92744, type: 3}
  - {fileID: 4653176916216709083, guid: aee2903e61ea36345bd1122d727b0a6d, type: 3}
  - {fileID: -1706839715261680557, guid: e1d03d181a953f64fa2bc67787aea93a, type: 3}
  - {fileID: -7210873807887048775, guid: 396a697e176f5214c92a0d7d08c34547, type: 3}
  - {fileID: -5704526582806562202, guid: 7529d59583ab69247952909a1953b0f2, type: 3}
  - {fileID: -8175047391691756042, guid: 91b9740e24e2ae14d8df12f1cc12de5a, type: 3}
  - {fileID: -8175047391691756042, guid: 91b9740e24e2ae14d8df12f1cc12de5a, type: 3}
  - {fileID: -8862641696791446209, guid: 38dabfe5a6ce4a84c9ebfd7c7908073a, type: 3}
  storyTexts:
  - "\uBA40\uACE0\uB3C4 \uBA3C \uC61B\uB0A0, \uC774 \uC138\uC0C1\uC740 \uD574\uC640
    \uB2EC\uB85C \uC774\uB8E8\uC5B4\uC838 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uBAA8\uB450\uAC00 \uAE68\uC5B4\uB09C \uC2DC\uAC04\uC744 \uBE44\uCD94\uB294
    \uD574\uC640 \uBAA8\uB450\uAC00 \uC7A0\uB4E0 \uC2DC\uAC04\uC744 \uBE44\uCD94\uB294
    \uB2EC"
  - "\uD574\uC640 \uB2EC\uC740 \uACE0\uC694\uD788 \uAC01\uC790\uC758 \uC758\uBB34\uB97C
    \uB2E4\uD558\uBA70 \uC0B4\uC544\uC654\uC2B5\uB2C8\uB2E4."
  - "\uC5B4\uB290 \uB0A0, \uB2EC\uC740 \uBB38\uB4DD \uAE68\uB2EC\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC790\uC2E0\uC740 \uB298 \uD574\uC758 \uBE5B\uC744 \uBA38\uAE08\uACE0 \n\uD574\uC758
    \uBC18\uB300\uD3B8\uC744 \uB300\uC2E0 \uBE44\uCD94\uACE0 \uC788\uC5C8\uB2E4\uB294
    \uC0AC\uC2E4\uC744."
  - "\"\uC774\uC81C \uB2F9\uC2E0\uC758 \uBC0F\uC744 \uBA38\uAE08\uB294 \uAC74 \uC9C8\uB838\uC5B4.
    \uB098\uB294 \uC2A4\uC2A4\uB85C \uBE5B\uC744 \uB0BC\uAC70\uC57C.\""
  - "\uB2EC\uC740 \uD574\uB97C \uC7A1\uC544\uBA39\uC5B4 \uADF8\uAC83\uC774 \uB0B4\uB294
    \uBE5B\uC744\n\uC628\uC804\uD788 \uD488\uAE30\uB85C \uACB0\uC2EC\uD558\uACE0
    \uB098\uC544\uAC14\uC2B5\uB2C8\uB2E4. "
  - "\uD574 \uC5ED\uC2DC \uBB34\uC5B8\uAC00\uB97C \uAEA0\uB2EC\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC790\uC2E0\uC774 \uD0DC\uC5B4\uB09C \uC21C\uAC04\uBD80\uD130 \uC9C0\uAE08\uAE4C\uC9C0,
    \uD55C\uC2DC\uB3C4 \uC26C\uC9C0 \uC54A\uACE0\n\uC790\uC2E0\uC758 \uBAB8\uC744
    \uB179\uC774\uBA70 \uBE5B\uC744 \uB0B4\uACE0 \uC788\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC744."
  - "\"\uC774\uB300\uB85C \uAC00\uB2E4\uAC04 \uC2A4\uC2A4\uB85C \uB179\uC544 \uC790\uBA78\uD558\uAC8C
    \uB420\uAC70\uC57C.\n\uB098\uB294 \uC544\uC9C1 \uB354 \uC624\uB798 \uC0B4\uACE0
    \uC2F6\uC5B4.\""
  storyImageUI: {fileID: 589927318}
  storyText: {fileID: 322652981}
  skipText: {fileID: 601505309}
  fadeSpeed: 1
  typingSpeed: 0.05
